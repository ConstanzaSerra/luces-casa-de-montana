# Copiá este archivo como .env y completá los valores.
PORT=3001
# Origen del frontend permitido por CORS (solo hace falta si front y back están en dominios distintos).
CORS_ORIGIN=http://localhost:5173

# Casilla que recibe las consultas del formulario.
CONTACT_TO=lucesvilladeldique@gmail.com

# SMTP para enviar los mails. Si se deja vacío, las consultas se muestran en la consola (modo desarrollo).
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
